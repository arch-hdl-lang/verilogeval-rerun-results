module TopModule
  port mode: in Bool;
  port too_cold: in Bool;
  port too_hot: in Bool;
  port fan_on: in Bool;
  port heater: out Bool comb_dep_on(mode, too_cold);
  port aircon: out Bool comb_dep_on(mode, too_hot);
  port fan: out Bool comb_dep_on(fan_on, mode, too_cold, too_hot);
end module TopModule
