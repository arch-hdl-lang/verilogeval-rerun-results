#!/usr/bin/env python3
"""Generate ARCH HDL for VerilogEval spec-to-RTL prompts.

This is the ARCH-lane counterpart to scripts/sv-generate. It intentionally
leaves the upstream Verilog generator untouched while reusing the same
problem files, sampling knobs, and [BEGIN]/[DONE] extraction convention.
"""

import argparse
import os
import re
import sys
import time
from collections import namedtuple


OPENAI_MODELS = [
    "gpt-3.5-turbo",
    "gpt-4",
    "gpt-4-turbo",
    "gpt-4o",
]

NIM_CHAT_MODELS = [
    "ai-llama2-70b",
    "ai-llama3-70b",
    "meta/llama-3.1-8b-instruct",
    "meta/llama-3.1-70b-instruct",
    "meta/llama-3.1-405b-instruct",
    "ai-codellama-70b",
    "ai-gemma-7b",
    "ai-codegemma-7b",
    "ai-mistral-7b-instruct-v2",
    "ai-mixtral-8x7b-instruct",
    "ai-mistral-large",
]

MANUAL_MODELS = [
    "manual-arch",
    "manual-rtl-coder",
    "manual-deepseek-coder-6.7b",
    "manual-deepseek-coder-33b",
]

MODEL_ALIASES = {
    "gpt3.5-turbo": "gpt-3.5-turbo",
    "gpt4": "gpt-4",
    "gpt4-turbo": "gpt-4-turbo",
    "ai-llama-3_1-8b-instruct": "meta/llama-3.1-8b-instruct",
    "ai-llama-3_1-70b-instruct": "meta/llama-3.1-70b-instruct",
    "ai-llama-3_1-405b-instruct": "meta/llama-3.1-405b-instruct",
}

MODELS_TO_REPEAT_SYSTEM_TO_HUMAN_MESSAGES = [
    "ai-mistral-large",
]

SYSTEM_MSG = """
You are an ARCH HDL designer that only writes syntactically correct ARCH code.
Do not write Verilog or SystemVerilog. Do not include explanations unless asked.
"""

ARCH_RULES_SUFFIX = """
Here are additional ARCH HDL rules and coding conventions.

 - Implement the requested top-level design as a construct named TopModule.

 - Use `module TopModule` for combinational or ordinary registered logic.
   Use `fsm TopModule` when the behavior is naturally a finite-state machine.

 - For every FSM problem, first derive a standard state transition table with
   exactly these columns: input condition, current state, next state, output.
   Also call out each input/output port's timing/type: input sampling edge,
   combinational/state-derived output, registered output, or `pipe_reg`
   latency. If you are writing files in a workspace, save this as
   `transition_table.md` beside the generated RTL. If the response must be
   code-only, embed the table as `///` ARCH doc comments above `fsm TopModule`.
   For serial protocols, the table must have a distinct row/state for every
   sampled protocol symbol boundary such as start, each data bit, stop/parity,
   done, and error/recovery.

 - In a state transition table, interpret the output column together with each
   port's timing/type note. For a combinational or state-derived output, the
   table entry is the value visible in the current state. For a registered or
   `pipe_reg` output, the table entry is the value assigned by that state's
   sequential action and must state when it becomes externally visible. Do not
   invent extra `done`/`valid` ports or extra states because of this rule.
   Choose combinational vs registered timing from the prompt/waveform; add a
   completion/valid state only when the protocol timing requires one.

 - Declare ports with ARCH syntax: `port name: in Type;` or
   `port name: out Type;`. Use `Bool` for one-bit logical signals and
   `UInt<N>` for N-bit vectors unless signed behavior is explicitly required.

 - Map clocks and resets to typed ports. For example, use
   `Clock<SysDomain>` for a positive-edge clock and
   `Reset<Sync, High>` or `Reset<Async, High>` according to the prompt.

 - Choose output timing from the prompt, waveform, and transition table. Use
   plain `port out: out T;` driven by `let` or `comb` for combinational,
   state-derived, or same-cycle FSM outputs. Use
   `port out: out pipe_reg<T, N> reset reset => 0;` only when a registered
   output and its latency are intended. Do not add a redundant `if reset`
   branch when the port or register already has a reset clause.

 - Use wrapping arithmetic (`+%`, `-%`, `*%`) when the intended result should
   stay at the destination width.

 - Use `let out = expr;` to drive a combinational output directly. Use
   `comb ... end comb` only when conditional assignment is needed.

 - Use ARCH block endings exactly: `end module TopModule`,
   `end fsm TopModule`, `end state Name`, `end seq`, and `end comb`.

 - Do not output markdown fences. Do not output SystemVerilog.
"""

BENCHMARK_INTEGRITY_SUFFIX = """
Benchmark integrity rules:

 - Solve this problem only from the text in this prompt plus the fixed ARCH
   guidance/examples included here.

 - Do not inspect or rely on VerilogEval `_test.sv` files, `_ref.sv` files,
   expected-output traces, simulator mismatch hints, or any other hidden
   evaluation artifact while writing the RTL.

 - Treat this problem as independent from every other VerilogEval problem.
   Do not rely on solutions, failures, logs, or debugging notes from previous
   problems. If problems are solved serially, use a fresh model context for
   each problem before generation.

 - If a later experiment intentionally allows compile/test feedback or repair,
   that must be logged as a separate repair-mode attempt, not as first-pass
   generation.
"""

NO_EXPLAIN_SUFFIX = """
Enclose your code with [BEGIN] and [DONE]. Only output the ARCH code snippet
and do NOT output anything else.
"""


class VerboseOutput:
    def __init__(self, verbose: bool):
        self.verbose = verbose

    def print(self, msg: str) -> None:
        if self.verbose:
            print(msg)


def parse_cmdline() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Generate ARCH HDL from a VerilogEval spec-to-RTL prompt."
    )
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument("-l", "--list-models", action="store_true")
    parser.add_argument("-m", "--model", default="gpt-4o")
    parser.add_argument("-t", "--temperature", type=float, default=0.8)
    parser.add_argument("-n", "--max-tokens", type=int, default=1024)
    parser.add_argument("-p", "--top-p", type=float, default=0.95)
    parser.add_argument("-e", "--explain", action="store_true")
    parser.add_argument("-x", "--examples", type=int, default=0)
    parser.add_argument("-r", "--rules", action="store_true")
    parser.add_argument("--task", default="spec-to-rtl")
    parser.add_argument("--output", default="-")
    parser.add_argument("prompt_filename")
    return parser.parse_args()


def list_models() -> None:
    print("\nOpenAI Models")
    for model in OPENAI_MODELS:
        print(f" - {model}")
    print("\nNIM Models")
    for model in NIM_CHAT_MODELS:
        print(f" - {model}")
    print("\nManual Models")
    for model in MANUAL_MODELS:
        print(f" - {model}")
    print("\nModel Aliases")
    for key, value in MODEL_ALIASES.items():
        print(f" - {key} : {value}")
    print("")


def build_prompt(opts: argparse.Namespace, prompt: str, model: str) -> str:
    scripts_dir = os.path.dirname(__file__)
    full_prompt = ""

    if model in MODELS_TO_REPEAT_SYSTEM_TO_HUMAN_MESSAGES:
        full_prompt += SYSTEM_MSG.strip() + "\n\n"

    if opts.examples:
        if opts.examples < 1 or opts.examples > 4:
            raise ValueError("--examples must be between 0 and 4")
        example_path = os.path.join(
            scripts_dir, f"arch-example-prefix_spec-to-rtl_{opts.examples}-shot.txt"
        )
        with open(example_path) as file:
            full_prompt += file.read().rstrip() + "\n\n"

    full_prompt += "Question:\n"
    full_prompt += "Translate the following RTL specification into ARCH HDL.\n\n"
    full_prompt += prompt.strip() + "\n"

    prompt_lc = prompt.lower()
    has_testbench_rule = (
        "_test.sv" in prompt_lc
        or "testbench" in prompt_lc
        or "test bench" in prompt_lc
        or "reference solution" in prompt_lc
        or "_ref.sv" in prompt_lc
    )
    has_context_rule = (
        "fresh context" in prompt_lc
        or "independent from every other" in prompt_lc
        or "previous problem" in prompt_lc
        or "serially" in prompt_lc
    )
    if not (has_testbench_rule and has_context_rule):
        full_prompt += BENCHMARK_INTEGRITY_SUFFIX

    if opts.rules:
        full_prompt += ARCH_RULES_SUFFIX

    if not opts.explain:
        full_prompt = full_prompt.rstrip() + "\n" + NO_EXPLAIN_SUFFIX

    full_prompt += "\nAnswer:\n"
    return full_prompt


def extract_arch_code(response: str) -> str:
    lines = response.splitlines()
    found_code_lines = []
    found_code_start = False
    found_code_end = False

    for line in lines:
        if not found_code_start:
            if line.strip() == "[BEGIN]":
                found_code_start = True
            elif line.lstrip().startswith("[BEGIN]"):
                found_code_lines.append(line.lstrip().replace("[BEGIN]", "", 1))
                found_code_start = True
        elif not found_code_end:
            if line.strip() == "[DONE]":
                found_code_end = True
            elif line.rstrip().endswith("[DONE]"):
                found_code_lines.append(line.rstrip().replace("[DONE]", ""))
                found_code_end = True
            else:
                found_code_lines.append(line)

    if found_code_lines:
        code = "\n".join(found_code_lines).strip()
    else:
        code = response.strip()
        code = re.sub(r"^```(?:arch)?\s*", "", code)
        code = re.sub(r"\s*```$", "", code)

    diagnostics = []
    if "[BEGIN]" in response and not found_code_start:
        diagnostics.append("// VERILOG-EVAL-ARCH: malformed [BEGIN] marker")
    if found_code_start and not found_code_end:
        diagnostics.append("// VERILOG-EVAL-ARCH: [DONE] marker not found")
    if "module TopModule" not in code and "fsm TopModule" not in code:
        diagnostics.append("// VERILOG-EVAL-ARCH: TopModule construct not found")

    if diagnostics:
        code = code.rstrip() + "\n\n" + "\n".join(diagnostics)

    return code.rstrip() + "\n"


def main() -> None:
    opts = parse_cmdline()

    if opts.list_models:
        list_models()
        return

    if opts.task != "spec-to-rtl":
        print("\nERROR: arch-generate currently supports --task=spec-to-rtl only\n")
        sys.exit(1)

    model = MODEL_ALIASES.get(opts.model, opts.model)
    if model not in OPENAI_MODELS + NIM_CHAT_MODELS + MANUAL_MODELS:
        print(f"\nERROR: Unknown model {model}\n")
        sys.exit(1)

    with open(opts.prompt_filename) as file:
        prompt = file.read()

    full_prompt = build_prompt(opts, prompt, model)
    out = VerboseOutput(opts.verbose)

    out.print("")
    out.print("System Message")
    out.print("-" * 74)
    out.print(SYSTEM_MSG.strip())
    out.print("")
    out.print("Prompt")
    out.print("-" * 74)
    out.print(full_prompt.rstrip())

    if model in OPENAI_MODELS:
        from langchain.schema import HumanMessage, SystemMessage
        from langchain.callbacks import get_openai_callback
        from langchain_openai import ChatOpenAI

        msgs = [SystemMessage(SYSTEM_MSG), HumanMessage(full_prompt)]
        llm = ChatOpenAI(
            model=model,
            temperature=opts.temperature,
            top_p=opts.top_p,
            max_tokens=opts.max_tokens,
        )
    elif model in NIM_CHAT_MODELS:
        from langchain.schema import HumanMessage, SystemMessage
        from langchain.callbacks import get_openai_callback
        from langchain_nvidia_ai_endpoints import ChatNVIDIA

        msgs = [SystemMessage(SYSTEM_MSG), HumanMessage(full_prompt)]
        llm = ChatNVIDIA(
            model=model,
            temperature=opts.temperature,
            top_p=opts.top_p,
            max_tokens=opts.max_tokens,
        )
    else:
        output_base, _ = os.path.splitext(opts.output)
        with open(output_base + "_fullprompt.txt", "w") as output_prompt_file:
            print(full_prompt.rstrip(), file=output_prompt_file)
        with open(output_base + "_systemprompt.txt", "w") as output_prompt_file:
            print(SYSTEM_MSG.strip(), file=output_prompt_file)
        response_path = output_base + "_response.txt"
        if os.path.exists(response_path):
            with open(response_path) as response_file:
                resp = namedtuple("Response", ["content"])(
                    content=response_file.read()
                )
        else:
            resp = namedtuple("Response", ["content"])(content="// Manually run")
        cb = namedtuple(
            "Callback",
            ["prompt_tokens", "completion_tokens", "total_tokens", "total_cost"],
        )(0, 0, 0, 0)

    if model not in MANUAL_MODELS:
        for _ in range(10):
            try:
                with get_openai_callback() as cb:
                    resp = llm.invoke(msgs)
                break
            except Exception as exc:
                print("")
                print("ERROR: LLM query failed, retrying in 20 seconds")
                print(type(exc))
                print(exc)
                print("")
                time.sleep(20)
        else:
            raise RuntimeError("LLM query failed after retries")

    out.print("")
    out.print("Response")
    out.print("-" * 74)
    out.print(resp.content)
    out.print("")
    out.print("Statistics")
    out.print("-" * 74)
    out.print(f"prompt_tokens = {cb.prompt_tokens}")
    out.print(f"resp_tokens   = {cb.completion_tokens}")
    out.print(f"total_tokens  = {cb.total_tokens}")
    out.print(f"total_cost    = {cb.total_cost}")

    code = extract_arch_code(resp.content)
    if opts.output == "-":
        print(code)
    else:
        with open(opts.output, "w") as file:
            print(code, file=file)


if __name__ == "__main__":
    main()
