#!/usr/bin/env python3
"""Summarize ARCH benchmark first-pass and repair accounting JSON files."""

import json
from pathlib import Path


def load_json(path):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return None


def normalize_status(item):
    status = item.get("status")
    if status in {"pass", "fail", "missing"}:
        return status
    if item.get("pass") is True:
        return "pass"
    if item.get("pass") is False:
        return "fail"
    if item.get("passed") is True:
        return "pass"
    if item.get("passed") is False:
        return "fail"
    if item.get("icarus_run") == "fail":
        return "fail"
    if any(item.get(key) == "fail" for key in ("arch_check", "arch_build", "verilator_lint", "icarus_compile")):
        return "fail"
    mismatches = item.get("mismatches")
    if isinstance(mismatches, int) and mismatches > 0:
        return "fail"
    if (
        item.get("arch_check") == "pass"
        and item.get("arch_build") == "pass"
        and item.get("icarus_compile") == "pass"
        and item.get("icarus_run") == "pass"
    ):
        return "pass"
    return status or "unknown"


def main() -> int:
    repo = Path.cwd()
    problems_path = repo / "dataset_spec-to-rtl" / "problems.txt"
    problems = [
        line.strip()
        for line in problems_path.read_text().splitlines()
        if line.strip()
    ]
    runs = repo / "runs" / "arch"
    runs.mkdir(parents=True, exist_ok=True)

    first_results = []
    repair_results = []
    repair_attempt_counts = {}

    for problem in problems:
        problem_dir = runs / problem
        first = load_json(problem_dir / "first_pass_result.json")
        if first is None:
            first = {
                "problem": problem,
                "status": "missing",
                "mismatches": None,
                "samples": None,
                "source": str(problem_dir / f"{problem}.arch"),
                "steps": [],
            }
        else:
            first["status"] = normalize_status(first)
        first_results.append(first)

        repairs = sorted(problem_dir.glob("repair_attempt_*_result.json"))
        repair_attempt_counts[problem] = len(repairs)
        for repair_path in repairs:
            repair = load_json(repair_path)
            if repair is not None:
                repair["status"] = normalize_status(repair)
                repair["result_file"] = str(repair_path)
                repair_results.append(repair)

    first_summary = {
        "total_problems": len(problems),
        "passed": sum(1 for item in first_results if item.get("status") == "pass"),
        "failed": sum(1 for item in first_results if item.get("status") == "fail"),
        "missing": sum(1 for item in first_results if item.get("status") == "missing"),
        "unknown": sum(1 for item in first_results if item.get("status") == "unknown"),
        "results": first_results,
    }
    repair_summary = {
        "total_repair_attempts": len(repair_results),
        "repair_attempt_counts": repair_attempt_counts,
        "passed_repairs": sum(
            1 for item in repair_results if item.get("status") == "pass"
        ),
        "failed_repairs": sum(
            1 for item in repair_results if item.get("status") == "fail"
        ),
        "results": repair_results,
    }

    (repo / "first_pass_accounting_summary.json").write_text(
        json.dumps(first_summary, indent=2, sort_keys=True) + "\n"
    )
    (repo / "repair_accounting_summary.json").write_text(
        json.dumps(repair_summary, indent=2, sort_keys=True) + "\n"
    )

    lines = [
        "# ARCH VerilogEval Run Report",
        "",
        "## First Pass",
        "",
        f"- Total problems: {first_summary['total_problems']}",
        f"- Passed: {first_summary['passed']}",
        f"- Failed: {first_summary['failed']}",
        f"- Missing: {first_summary['missing']}",
        f"- Unknown: {first_summary['unknown']}",
        "",
        "## Repairs",
        "",
        f"- Total repair attempts: {repair_summary['total_repair_attempts']}",
        f"- Passed repairs: {repair_summary['passed_repairs']}",
        f"- Failed repairs: {repair_summary['failed_repairs']}",
        "",
        "## Incomplete First-Pass Problems",
        "",
    ]
    missing = [item["problem"] for item in first_results if item.get("status") == "missing"]
    if missing:
        lines.extend(f"- {problem}" for problem in missing)
    else:
        lines.append("- None")
    lines.extend(["", "## Failed First-Pass Problems", ""])
    failed = [item for item in first_results if item.get("status") == "fail"]
    if failed:
        for item in failed:
            mismatch = item.get("mismatches")
            samples = item.get("samples")
            suffix = ""
            if mismatch is not None and samples is not None:
                suffix = f" ({mismatch} mismatches in {samples} samples)"
            lines.append(f"- {item['problem']}{suffix}")
    else:
        lines.append("- None")
    lines.extend(["", "## Repair Attempts By Problem", ""])
    attempted = {
        problem: count
        for problem, count in repair_attempt_counts.items()
        if count
    }
    if attempted:
        for problem, count in attempted.items():
            lines.append(f"- {problem}: {count}")
    else:
        lines.append("- None")
    lines.extend(["", "## Failed Repair Attempts", ""])
    failed_repairs = [
        item for item in repair_results if item.get("status") == "fail"
    ]
    if failed_repairs:
        for item in failed_repairs:
            problem = item.get("problem", "unknown")
            mismatch = item.get("mismatches")
            samples = item.get("samples")
            result_file = item.get("result_file")
            suffix = ""
            if mismatch is not None and samples is not None:
                suffix = f" ({mismatch} mismatches in {samples} samples)"
            if result_file:
                suffix = f"{suffix} [{result_file}]"
            lines.append(f"- {problem}{suffix}")
    else:
        lines.append("- None")
    lines.append("")
    (repo / "FINAL_REPORT.md").write_text("\n".join(lines))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
